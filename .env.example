# --- Base de données ---
# Par défaut : SQLite local. Pour PostgreSQL : postgresql://user:pass@host:5432/radar
DATABASE_URL=sqlite:///data/radar.db

# --- Profil pour le matching ---
# Chemin du CV / profil texte comparé aux offres
PROFILE_PATH=profile/cv.md

# --- Recherche d'offres (ce que le radar collecte) ---
# Ces mots-clés définissent CE QUE le radar va chercher, indépendamment du CV.
# Le CV ne sert qu'à classer les offres par pertinence, pas à les filtrer.
SEARCH_KEYWORDS=stage développement logiciel,stage software engineer,stage IA,stage machine learning,stage data,stage full stack
SEARCH_LOCATIONS=France
SEARCH_INTERNATIONAL=false

# Collecteurs exécutés : "sample" (données de démo, aucun réseau) par défaut.
# Ajoute "linkedin" pour activer le scraping réel des offres LinkedIn.
ACTIVE_COLLECTORS=sample

# --- Scheduler (relance automatique de la collecte, optionnel) ---
# true pour que le radar relance la collecte tout seul à intervalle régulier.
SCHEDULER_ENABLED=false
REFRESH_INTERVAL_HOURS=24
# Fenêtre (heures) pendant laquelle une offre fraîchement détectée est « nouvelle ».
NEW_WINDOW_HOURS=24

# --- LLM (génération de texte, optionnel) ---
# Laisser vide pour désactiver la génération (mode dégradé)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Matching (optionnel) ---
# Modèle d'embeddings. Si sentence-transformers n'est pas installé,
# le radar bascule automatiquement sur un scoring par mots-clés.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
